# ==============================================================================
# Unified Network Monitoring Application - Environment Configuration
# ==============================================================================

# Central Backend & Server Port (Server-side)
PORT=3000

# Authentication & Access Control
# Set to 'true' to mandate API token for central backend API routes (/api/regions/*)
REQUIRE_AUTH=false
CENTRAL_API_KEY=""

# Admin Account Creation Secret
# Used to authorize initial operator/admin account provisioning from the login interface
ADMIN_SETUP_SECRET="network-admin-2026"

# ------------------------------------------------------------------------------
# Regional Ping Server Endpoints (Server-Side)
# ------------------------------------------------------------------------------
# 1. IN-DC01 — Bangalore TATA
REGIONAL_IN_DC01_URL=""

# 2. IN-DC02 — Bangalore ACT
REGIONAL_IN_DC02_URL=""

# 3. LK-DC01 — Sri Lanka
REGIONAL_LK_DC01_URL=""

# 4. SG-DC01 — Singapore
REGIONAL_SG_DC01_URL=""

# Shared secret key passed to regional daemons (via Authorization: Bearer <key>)
REGIONAL_API_KEY=""

# ------------------------------------------------------------------------------
# Regional Push Agent Mode (Outbound-only VMs behind NAT / VPCs)
# ------------------------------------------------------------------------------
AGENT_KEY_IN_DC01=""
AGENT_KEY_IN_DC02=""
AGENT_KEY_LK_DC01=""
AGENT_KEY_SG_DC01=""

# Upstash Redis REST Storage (Required only if using Push Agent mode)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# Firebase Client Configuration (Optional overrides; defaults to firebase-applet-config.json)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# ------------------------------------------------------------------------------
# AI Studio & Hosting
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# History, anomaly detection & automatic monitoring  (all optional)
# ------------------------------------------------------------------------------
# History is stored in Upstash Redis when UPSTASH_REDIS_REST_URL/TOKEN (above) are set,
# otherwise in ./data/netpulse-history.json (needs a persistent disk; temporary on Vercel).
HISTORY_RETENTION_DAYS=90

# Automatic probe rounds (no browser needed). 0 / empty = off. Ping only.
MONITOR_INTERVAL_MIN=0
MONITOR_PING_COUNT=10
# Secret for an external scheduler / Vercel Cron calling GET /api/monitor/run
CRON_SECRET=""

# Anomaly detector (defaults shown)
ANOMALY_LOOKBACK_DAYS=7
ANOMALY_MIN_BASELINE=8
ANOMALY_Z_WARN=3.5
ANOMALY_Z_CRIT=6
ANOMALY_MIN_CHANGE_PCT=30
LOSS_WARN_PCT=5
LOSS_CRIT_PCT=20

# ------------------------------------------------------------------------------
# Daily check + e-mail (Resend free plan is enough: 1 summary e-mail per day)
# ------------------------------------------------------------------------------
# Vercel Cron (see vercel.json) calls GET /api/monitor/daily once a day with "Authorization: Bearer <CRON_SECRET>".
# It runs ping + speed for all regions and sends ONE summary e-mail: "Everything is good" or "Completed with notes".
# A separate RED critical e-mail is sent only when ALERT_CONSECUTIVE_TIMEOUTS (default 5) ping requests in a row time out.
RESEND_API_KEY=""
ALERT_EMAIL_TO="you@company.com,team@company.com"
ALERT_EMAIL_FROM="Network Monitor <alerts@yourdomain.com>"
ALERT_DASHBOARD_URL="https://your-app.vercel.app"
ALERT_CONSECUTIVE_TIMEOUTS=5
# seconds each download / upload speed test runs in the daily check (2-10, default 5)
DAILY_SPEED_SECONDS=5
# safety limit: how long (seconds) the daily job waits for slow agents before sending the e-mail (default 50; max 280).
# Keep it below maxDuration in vercel.json (60). If your Vercel plan allows a longer function, raise both.
DAILY_MAX_WAIT_SECONDS=50
