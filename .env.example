# ==============================================================================
# Unified Network Monitoring Application - Environment Configuration
# ==============================================================================

# Central Backend & Server Port (Server-side)
PORT=3000

# Authentication & Access Control
# Set to 'true' to mandate API token for central backend API routes (/api/regions/*)
REQUIRE_AUTH=false
CENTRAL_API_KEY=""

# Admin Account Creation Secret
# Used to authorize initial operator/admin account provisioning from the login interface
ADMIN_SETUP_SECRET="network-admin-2026"

# ------------------------------------------------------------------------------
# Regional Ping Server Endpoints (Server-Side)
# ------------------------------------------------------------------------------
# 1. IN-DC01 — Bangalore TATA
REGIONAL_IN_DC01_URL=""

# 2. IN-DC02 — Bangalore ACT
REGIONAL_IN_DC02_URL=""

# 3. LK-DC01 — Sri Lanka
REGIONAL_LK_DC01_URL=""

# 4. SG-DC01 — Singapore
REGIONAL_SG_DC01_URL=""

# Shared secret key passed to regional daemons (via Authorization: Bearer <key>)
REGIONAL_API_KEY=""

# ------------------------------------------------------------------------------
# Regional Push Agent Mode (Outbound-only VMs behind NAT / VPCs)
# ------------------------------------------------------------------------------
AGENT_KEY_IN_DC01=""
AGENT_KEY_IN_DC02=""
AGENT_KEY_LK_DC01=""
AGENT_KEY_SG_DC01=""

# Upstash Redis REST Storage (Required only if using Push Agent mode)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# Firebase Client Configuration (Optional overrides; defaults to firebase-applet-config.json)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# ------------------------------------------------------------------------------
# AI Studio & Hosting
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
