{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Authorized operator and administrator user profile document",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique Firebase Auth UID of the user"
        },
        "fullName": {
          "type": "string",
          "description": "The full name of the operator"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The work email address of the operator"
        },
        "role": {
          "type": "string",
          "enum": ["operator", "admin"],
          "description": "The access role of the user"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of user registration"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of profile update"
        }
      },
      "required": ["userId", "fullName", "email"]
    },
    "PingSession": {
      "title": "Ping Monitoring Session",
      "description": "Historical record of multi-region ICMP ping benchmark test",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique session identifier"
        },
        "startedAt": {
          "type": "string",
          "description": "ISO timestamp when probing started"
        },
        "completedAt": {
          "type": "string",
          "description": "ISO timestamp when probing completed"
        },
        "targetIp": {
          "type": "string",
          "description": "Target IP address probed (8.8.8.8)"
        },
        "pingCount": {
          "type": "number",
          "description": "Packets dispatched per region"
        }
      },
      "required": ["id", "startedAt", "targetIp", "pingCount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile records restricted to owner and authenticated operators"
    },
    "/ping_sessions/{sessionId}": {
      "schema": "PingSession",
      "description": "Persistent ping benchmark session history accessible across operator devices"
    }
  }
}
